{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>sanity-io/renovate-config"],
  "ignorePresets": ["github>sanity-io/renovate-config:group-non-major"],
  "automerge": true,
  "automergeType": "pr",
  "automergeStrategy": "squash",
  "platformAutomerge": true,
  "packageRules": [
    {
      "matchPackageNames": ["oxlint", "oxlint-tsgolint"],
      "groupName": "oxlint",
      "semanticCommitType": "chore"
    },
    {
      "description": "The research outputs were recorded against these exact versions.",
      "matchFileNames": ["research/package.json"],
      "enabled": false
    }
  ]
}
